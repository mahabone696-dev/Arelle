# ─── Core (Phase 1) ─────────────────────────────────────────────
# PostgreSQL. Use the pooled connection string in production.
DATABASE_URL="postgresql://geo:geo@localhost:5432/geo_local"
# Auth.js signing secret: `openssl rand -base64 32`
AUTH_SECRET=""
# Canonical URL (required in production behind proxies)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional OAuth providers — enabled automatically when both values are set
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Private deployments: only these emails / @domains may sign up (empty = open sign-up)
SIGNUP_ALLOWLIST=""
# Comma-separated emails that become platform admins on sign-up
PLATFORM_ADMIN_EMAILS=""
LOG_LEVEL="info"

# ─── Feature flags (default off; DB FeatureFlag rows override) ─
FEATURE_GEMINI="false"
FEATURE_PERPLEXITY="false"
FEATURE_ACTION_ENGINE="false"
FEATURE_BILLING="false"
FEATURE_PUBLIC_AUDIT="false"
FEATURE_REPORTS="false"
# AI sentiment only for answer languages without a deterministic lexicon (costs 1 call per answer)
FEATURE_ANALYSIS_AI="false"

# ─── Visibility score (Phase 4) ─────────────────────────────────
# Weights: mention, position, shareOfVoice, citation, sentiment (normalized; default 35,25,20,10,10)
VISIBILITY_WEIGHTS=""

# ─── Onboarding AI (Phase 2) ────────────────────────────────────
# Without a key, onboarding uses a clearly labelled metadata/template fallback.
OPENAI_API_KEY=""
OPENAI_ONBOARDING_MODEL="gpt-4.1-mini"

# ─── Crawler (Phase 2) — values are clamped to hard ceilings ────
CRAWLER_MAX_PAGES="15"
CRAWLER_MAX_BYTES="2000000"
CRAWLER_TIMEOUT_MS="10000"

# ─── Scans: queue, OpenAI answers, cost safety (Phase 3) ────────
# Required by the web app (enqueue) and the worker process (consume).
REDIS_URL="redis://localhost:6379"
# Model queried for answers; must have pricing in AIModel (pnpm db:seed).
OPENAI_SCAN_MODEL="gpt-4.1-mini"
# Ground answers in web search (citations). Billed per search call.
OPENAI_SCAN_WEB_SEARCH="true"
# Optional API base URL (proxies / test doubles). Leave empty for api.openai.com.
OPENAI_BASE_URL=""
# Hard daily caps on provider queries (UTC day). The plan limit also applies; lower wins.
SCAN_ORG_DAILY_QUERY_CAP="10000"
# Attempts per query incl. first; exponential backoff base (ms).
SCAN_JOB_MAX_ATTEMPTS="3"
SCAN_JOB_BACKOFF_MS="5000"
GEMINI_API_KEY=""
GEMINI_MODEL=""
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"
SCAN_GLOBAL_DAILY_QUERY_CAP="5000"
SCAN_MAX_QUERIES_PER_SCAN="1000"

# ─── Billing (Phase 8) ──────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_AGENCY=""

# ─── Public audit (Phase 9) ─────────────────────────────────────
AUDIT_IP_SALT=""

# ─── Monitoring ─────────────────────────────────────────────────
SENTRY_DSN=""
